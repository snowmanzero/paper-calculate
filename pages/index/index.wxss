page {
  background: linear-gradient(180deg, #f8fafc, #eef2f7);
}

.wrap { padding: 24rpx 24rpx 80rpx; }

.title { font-size: 40rpx; font-weight: 700; color: #111827; margin-bottom: 24rpx; }

/* ========== 卡片 ========== */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 26rpx;
  box-shadow: 0 2rpx 4rpx rgba(16,24,40,.06), 0 12rpx 40rpx -20rpx rgba(16,24,40,.18);
  margin-bottom: 20rpx;
}

.field + .field { margin-top: 24rpx; }
.field-row { display: flex; gap: 18rpx; }
.field-row .field { flex: 1; min-width: 0; margin-top: 0; }

.label { font-size: 26rpx; font-weight: 600; color: #374151; margin-bottom: 12rpx; }
.label .opt { font-weight: 500; color: #9ca3af; font-size: 24rpx; margin-left: 8rpx; }
.section-title { font-size: 26rpx; font-weight: 600; color: #374151; margin-bottom: 16rpx; }

.main-input {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 24rpx;
  font-size: 36rpx;
  font-weight: 600;
  border: 3rpx solid #e5e7eb;
  border-radius: 14rpx;
  background: #fbfcfe;
  color: #111827;
  box-sizing: border-box;
}
.main-input:focus { border-color: #2563eb; background: #fff; }
.ph { color: #b9c0cc; font-weight: 500; font-size: 30rpx; }

.divider { height: 1rpx; background: #e5e7eb; margin: 24rpx 0; }

/* ========== 克重标签 ========== */
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.chip {
  padding: 10rpx 22rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e7eb;
  background: #fff;
  color: #4b5563;
  line-height: 1.2;
}
.chip.on { background: #2563eb; border-color: #2563eb; color: #fff; }
.chip.add {
  font-weight: 800;
  padding: 10rpx 26rpx;
  border-style: dashed;
  color: #2563eb;
  border-color: #bfdbfe;
  background: #f0f7ff;
}
.chip-input {
  width: 160rpx;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 22rpx;
  font-size: 26rpx;
  border: 3rpx solid #2563eb;
  border-radius: 999rpx;
  background: #fff;
  color: #111827;
  font-weight: 600;
  box-sizing: border-box;
}

/* ========== 大度/正度结果 ========== */
.result-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.result-card {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
  padding: 28rpx 22rpx;
}
.result-card.full { margin-bottom: 20rpx; }

.rc-title { font-size: 32rpx; font-weight: 700; color: #111827; }
.rc-dim { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; margin-bottom: 20rpx; }

.rc-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 10rpx;
}
.rc-label { font-size: 24rpx; color: #6b7280; }
.rc-val { font-weight: 700; font-size: 32rpx; line-height: 1.15; }
.rc-val.blue { color: #2563eb; }
.rc-val.dark { color: #1f2937; }

.res-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

/* ========== 分切结果 ========== */
.cut-card { padding: 28rpx 22rpx; }

.cut-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}
.cut-title { font-size: 34rpx; font-weight: 700; color: #111827; }
.add-spec-btn {
  font-size: 24rpx;
  font-weight: 700;
  color: #2563eb;
  border: 1rpx dashed #bfdbfe;
  background: #f0f7ff;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
}

.cut-section + .cut-section { margin-top: 28rpx; }

.series-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #2563eb;
  margin-bottom: 14rpx;
}

.qty-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.qty-btn {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e7eb;
  background: #fff;
  color: #4b5563;
}
.qty-btn.on { border-color: #2563eb; background: #2563eb; color: #fff; }

.qty-add-btn {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1;
  padding: 8rpx 20rpx;
  min-width: 52rpx;
  text-align: center;
  border-radius: 999rpx;
  border: 1rpx dashed #bfdbfe;
  background: #f0f7ff;
  color: #2563eb;
}
.qty-input {
  width: 120rpx;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
  border: 3rpx solid #2563eb;
  background: #fff;
  color: #111827;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}

.cut-items { display: flex; flex-direction: column; gap: 16rpx; }
.cut-item {
  width: 100%;
  background: #f9fafb;
  border: 1rpx solid #eef2f7;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.cut-item-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 14rpx;
  flex-wrap: wrap;
}
.ci-name { font-size: 30rpx; font-weight: 700; color: #111827; }
.ci-fold {
  font-size: 22rpx;
  font-weight: 700;
  color: #2563eb;
  background: #eff6ff;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}
.ci-fold.manual { background: #fef3c7; color: #b45309; }
.ci-dim { font-size: 22rpx; color: #9ca3af; margin-left: auto; }
.ci-remove {
  font-size: 32rpx;
  color: #cbd5e1;
  padding: 0 4rpx;
  margin-left: 8rpx;
  line-height: 1;
}

.ci-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 25rpx;
  padding: 6rpx 0;
  color: #4b5563;
  gap: 16rpx;
}
.ci-val {
  font-weight: 600;
  color: #111827;
  font-size: 25rpx;
  text-align: right;
  flex-shrink: 0;
}
.ci-row.custom { color: #2563eb; }
.ci-row.custom .ci-val { color: #2563eb; font-weight: 700; }

.empty-tip {
  text-align: center;
  color: #9ca3af;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* ========== 说明 ========== */
.hint {
  margin-top: 8rpx;
  padding: 24rpx 26rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 4rpx rgba(16,24,40,.05);
}
.hint-line { font-size: 24rpx; color: #6b7280; line-height: 1.9; }

/* ========== 弹窗 ========== */
.dialog-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,.45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}
.dialog {
  width: 100%;
  max-width: 640rpx;
  max-height: 84vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}
.dialog-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 24rpx;
  text-align: center;
}
.dialog-section {
  font-size: 24rpx;
  font-weight: 700;
  color: #2563eb;
  margin: 20rpx 0 12rpx;
}
.spec-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.spec-chip {
  padding: 10rpx 22rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e5e7eb;
  background: #fff;
  color: #4b5563;
}
.spec-chip.on {
  border-color: #2563eb;
  background: #2563eb;
  color: #fff;
}
.dialog-divider {
  height: 1rpx;
  background: #e5e7eb;
  margin: 24rpx 0 4rpx;
}
.dialog-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.dialog-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fbfcfe;
  box-sizing: border-box;
}
.paper-toggle { display: flex; gap: 12rpx; width: 100%; }
.paper-btn {
  flex: 1;
  text-align: center;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: 3rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #fbfcfe;
  color: #4b5563;
  box-sizing: border-box;
}
.paper-btn.on {
  border-color: #2563eb;
  background: #2563eb;
  color: #fff;
}
.dialog-add-btn {
  margin-top: 16rpx;
  text-align: center;
  height: 80rpx;
  line-height: 80rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 12rpx;
}
.dialog-done {
  margin-top: 20rpx;
  text-align: center;
  height: 88rpx;
  line-height: 88rpx;
  background: #2563eb;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 12rpx;
}